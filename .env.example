# Google Search Console site verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta Pixel ID, from Meta Events Manager > Data Sources > your pixel.
# Not a secret, it is public in every page that loads it, but nothing
# is sent until a visitor accepts the cookie banner.
# Leave empty to keep the site exactly as it is today: no banner, no pixel.
NEXT_PUBLIC_META_PIXEL_ID=
